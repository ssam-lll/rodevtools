{
	"info": {
		"_postman_id": "a8f12c34-7890-4abc-9def-rodevtools01",
		"name": "RoDevTools API",
		"description": "Colección completa para pruebas de todos los endpoints del backend RoDevTools (Spring Boot).\n\nIncluye:\n- Autenticación (Registro, Login, Cambio de Contraseña y Eliminación de Cuenta)\n- Universos y Juegos de Roblox (Listado paginado, detalle X-Ray, Rising Stars, Resumen de Mercado, Exportación CSV y Sincronización Bajo Demanda)\n- Proxy de miniaturas (Thumbnails de Roblox)\n- Radar personal del usuario (Listar, Agregar, Eliminar individual/lote/total, y Exportar CSV)",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "01. Authentication",
			"description": "Endpoints de autenticación y gestión de cuenta",
			"item": [
				{
					"name": "1. Registrar Usuario",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"// Si no deseas cambiar el email manualmente en cada prueba,",
									"// puedes descomentar la siguiente línea para generar un email único aleatorio:",
									"// pm.collectionVariables.set('userEmail', 'user_' + Date.now() + '@example.com');"
								],
								"type": "text/javascript"
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code es 200 (OK)\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Retorna Token JWT y datos del usuario\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('token');",
									"    pm.expect(jsonData).to.have.property('email');",
									"    pm.expect(jsonData).to.have.property('role');",
									"    ",
									"    pm.collectionVariables.set(\"token\", jsonData.token);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"{{userEmail}}\",\n    \"password\": \"{{userPassword}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/register",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"register"
							]
						},
						"description": "Registra una nueva cuenta de usuario.\nNota: El backend aplica Rate Limit de 3 registros por hora por IP."
					},
					"response": []
				},
				{
					"name": "2. Iniciar Sesión (Login)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code es 200 (OK)\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Retorna Token JWT válido\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('token');",
									"    pm.expect(jsonData.email).to.eql(pm.collectionVariables.get(\"userEmail\"));",
									"    ",
									"    pm.collectionVariables.set(\"token\", jsonData.token);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"{{userEmail}}\",\n    \"password\": \"{{userPassword}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"login"
							]
						},
						"description": "Autentica un usuario existente y devuelve el token JWT.\nNota: El backend aplica Rate Limit de 5 intentos por 15 minutos por IP."
					},
					"response": []
				},
				{
					"name": "3. Cambiar Contraseña",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code es 200 (OK)\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Confirma actualización de contraseña\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.message).to.eql(\"Password updated successfully\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "PATCH",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"currentPassword\": \"{{userPassword}}\",\n    \"newPassword\": \"{{userPassword}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/password",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"password"
							]
						},
						"description": "Actualiza la contraseña del usuario autenticado verificando la contraseña actual."
					},
					"response": []
				},
				{
					"name": "4. Eliminar Cuenta",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code es 200 (OK)\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Confirma eliminación de cuenta y radar\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.message).to.eql(\"Account and radar data deleted successfully\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "DELETE",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"password\": \"{{userPassword}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/account",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"account"
							]
						},
						"description": "Elimina permanentemente la cuenta del usuario autenticado y todos sus juegos en radar tras verificar su contraseña."
					},
					"response": []
				}
			]
		},
		{
			"name": "02. Universes & Analytics",
			"description": "Consultas públicas, exportación y sincronización bajo demanda de universos de Roblox",
			"item": [
				{
					"name": "1. Listar Universos Paginados",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code es 200 (OK)\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Respuesta contiene paginación y array de content\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('content');",
									"    pm.expect(Array.isArray(jsonData.content)).to.be.true;",
									"    ",
									"    if (jsonData.content.length > 0) {",
									"        var firstGame = jsonData.content[0];",
									"        pm.expect(firstGame).to.have.property('universeId');",
									"        pm.expect(firstGame).to.have.property('name');",
									"        pm.expect(firstGame).to.have.property('activePlayers');",
									"        ",
									"        pm.collectionVariables.set(\"universeId\", firstGame.universeId);",
									"        if (firstGame.rootPlaceId) {",
									"            pm.collectionVariables.set(\"placeId\", firstGame.rootPlaceId);",
									"        }",
									"    }",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/universes?page=0&size=20&sort=playing&dir=desc",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"universes"
							],
							"query": [
								{
									"key": "page",
									"value": "0",
									"description": "Número de página (0-indexed)"
								},
								{
									"key": "size",
									"value": "20",
									"description": "Tamaño de página (1 a 100)"
								},
								{
									"key": "sort",
									"value": "playing",
									"description": "Campo de ordenamiento: playing, name, creator, visits, rating, category"
								},
								{
									"key": "dir",
									"value": "desc",
									"description": "Dirección: asc o desc"
								},
								{
									"key": "search",
									"value": "",
									"description": "Filtro opcional por nombre de juego",
									"disabled": true
								},
								{
									"key": "category",
									"value": "",
									"description": "Filtro opcional por categoría",
									"disabled": true
								}
							]
						},
						"description": "Retorna lista paginada de juegos/universos almacenados en la base de datos. Cada juego incluye su universeId, rootPlaceId, nombre y métricas."
					},
					"response": []
				},
				{
					"name": "2. Detalle X-Ray de Juego por ID",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code es 200 (OK)\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Retorna estructura X-Ray completa del juego\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('universeId');",
									"    pm.expect(jsonData).to.have.property('name');",
									"    pm.expect(jsonData).to.have.property('monthlyRevenue');",
									"    pm.expect(jsonData).to.have.property('dailyMetrics');",
									"    pm.expect(Array.isArray(jsonData.dailyMetrics)).to.be.true;",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/universes/{{universeId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"universes",
								"{{universeId}}"
							]
						},
						"description": "Obtiene la analítica detallada X-Ray de un juego (métricas diarias, ingresos estimados, ccu promedio). Si el juego no existe en BD, el backend invoca automáticamente la API de Roblox para sincronizarlo."
					},
					"response": []
				},
				{
					"name": "3. Resolver Detalle X-Ray (Resolve)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code es 200 (OK)\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Retorna analítica X-Ray resuelta correctamente\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('universeId');",
									"    pm.expect(jsonData).to.have.property('name');",
									"    pm.expect(jsonData).to.have.property('creator');",
									"    pm.expect(jsonData).to.have.property('activePlayers');",
									"    pm.expect(jsonData).to.have.property('dailyMetrics');",
									"    pm.expect(Array.isArray(jsonData.dailyMetrics)).to.be.true;",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/universes/resolve?query={{universeId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"universes",
								"resolve"
							],
							"query": [
								{
									"key": "query",
									"value": "{{universeId}}",
									"description": "Acepta: Universe ID (ej: 113491250), Root Place ID (ej: 920587237), URL completa de Roblox (ej: https://www.roblox.com/games/920587237/Adopt-Me) o nombre del juego."
								}
							]
						},
						"description": "Endpoint inteligente y fuertemente tipado para resolver juegos. Si se pasa un Place ID o enlace web que no está en la base de datos local, consulta la API de Roblox en tiempo real y lo persiste."
					},
					"response": []
				},
				{
					"name": "4. Juegos en Crecimiento (Rising Stars)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code es 200 (OK)\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Retorna listado paginado de Rising Stars\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('content');",
									"    pm.expect(Array.isArray(jsonData.content)).to.be.true;",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/universes/rising?page=0&size=20&sort=growth24h&dir=desc&minPlaying=100&hours=24",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"universes",
								"rising"
							],
							"query": [
								{
									"key": "page",
									"value": "0"
								},
								{
									"key": "size",
									"value": "20"
								},
								{
									"key": "sort",
									"value": "growth24h",
									"description": "Campos: growth24h, name, creator, activePlayers, rating"
								},
								{
									"key": "dir",
									"value": "desc"
								},
								{
									"key": "minPlaying",
									"value": "100",
									"description": "Jugadores concurrentes mínimos"
								},
								{
									"key": "maxPlaying",
									"value": "100000000",
									"disabled": true
								},
								{
									"key": "hours",
									"value": "24",
									"description": "Ventana de cálculo en horas"
								},
								{
									"key": "search",
									"value": "",
									"disabled": true
								}
							]
						},
						"description": "Retorna juegos ordenados por tasa de crecimiento y health score durante la ventana de tiempo especificada."
					},
					"response": []
				},
				{
					"name": "5. Resumen Global del Mercado (Market Summary)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code es 200 (OK)\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Retorna métricas agregadas del mercado\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('totalTrackedGames');",
									"    pm.expect(jsonData).to.have.property('totalActivePlayers');",
									"    pm.expect(jsonData).to.have.property('totalVisits');",
									"    pm.expect(jsonData).to.have.property('averageRating');",
									"    pm.expect(jsonData).to.have.property('estimatedMarketMonthlyRevenueUsd');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/universes/stats/summary",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"universes",
								"stats",
								"summary"
							]
						},
						"description": "Retorna estadísticas globales agregadas de todos los juegos rastreados (total juegos, jugadores activos, visitas, rating promedio e ingreso mensual estimado del mercado)."
					},
					"response": []
				},
				{
					"name": "6. Exportar Analítica X-Ray a CSV",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code es 200 (OK)\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Retorna CSV con encabezados esperados\", function () {",
									"    pm.expect(pm.response.text()).to.include(\"universeId,gameName,day,averageCcu,dailyVisits,avgPlaytimeMinutes,estimatedDailyRevenueUsd\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/universes/{{universeId}}/export/csv",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"universes",
								"{{universeId}}",
								"export",
								"csv"
							]
						},
						"description": "Descarga en formato CSV el historial de analítica diaria X-Ray de un universo."
					},
					"response": []
				},
				{
					"name": "7. Sincronizar Universo Bajo Demanda (Con Cooldown)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code es 200 (OK)\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Retorna detalle X-Ray sincronizado\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('universeId');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
